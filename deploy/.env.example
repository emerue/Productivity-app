# /srv/frog/.env  (chmod 600, owned by frog)

# Public hostname, used by the Nginx template and certbot.
DOMAIN=tasks.example.com

# Node listens on 127.0.0.1 only; Nginx proxies to it.
PORT=3080

# store.json, backups/ and archive/ live here. Never inside a web root.
DATA_DIR=/srv/frog/data

# bcrypt hash of your password. Generate with:
#   cd /srv/frog/app && npm run hash-password
# Keep the single quotes: the hash contains $ characters.
PASSWORD_HASH='$2b$12$replace.with.your.own.hash.............................'

# Signs the session cookie. At least 32 random characters:
#   openssl rand -base64 48
# Changing it signs out every device.
SESSION_SECRET=replace-with-output-of-openssl-rand-base64-48

# Server timezone for logs; the app's own day boundary comes from Settings.
TZ=Africa/Lagos
