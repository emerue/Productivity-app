{
  "name": "frog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b shared server && tsc -p client --noEmit && tsc -p client/tsconfig.sw.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "hash-password": "npm run hash-password -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  }
}
